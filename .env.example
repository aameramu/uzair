# SMTP Configuration for Email Sending
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control

# Zoho SMTP settings
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=info@uiconsultancy.com
SMTP_PASSWORD=your-zoho-email-password-or-app-password
SMTP_FROM_EMAIL=info@uiconsultancy.com
SMTP_FROM_NAME=U & I Consultancy Website
SMTP_TO_EMAIL=info@uiconsultancy.com
SMTP_TO_NAME=U & I Consultancy
